---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found" description="Page not found">
  <section class="max-w-4xl mx-auto px-6 pt-32 pb-16 text-center">
    <p class="text-8xl font-display font-bold gradient-text mb-4">404</p>
    <p class="text-xl text-gray-500 mb-8">This page doesn't exist.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-surface-200 text-gray-300 hover:text-white border border-white/5 hover:border-white/10 transition-all"
    >
      Back to portfolio
    </a>
  </section>
</BaseLayout>
