---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';

const allProjects = await Astro.glob('../content/projects/*.mdx');

const projects = allProjects
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout
  title="Georgios Giannakoudakis - 3D Artist"
  description="Portfolio of Georgios Giannakoudakis, 3D Artist and MSc graduate from Utrecht University. Specializing in 3D modeling, texturing, and visualization."
>
  <!-- Hero Section -->
  <section class="relative px-6 pt-24 pb-16 md:pt-32 md:pb-24 max-w-7xl mx-auto">
    <div class="max-w-3xl">
      <p class="text-sm font-mono text-accent-light mb-4 animate-fade-in">3D Artist / Designer</p>
      <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] mb-6 animate-slide-up">
        Crafting Worlds in <span class="text-accent-light">3D</span>
      </h1>
      <p class="text-lg text-gray-500 max-w-3xl animate-slide-up" style="animation-delay: 100ms">
        3D Artist with an MSc from Utrecht University. Passionate about bringing creative visions to life through 3D modeling, texturing, lighting, and real-time rendering.
      </p>
    </div>
  </section>

  <!-- Project Grid -->
  <section class="px-6 pb-24 max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-10">
      <h2 class="font-display text-xl font-semibold text-white">Selected Work</h2>
      <span class="text-sm font-mono text-gray-600">{projects.length} projects</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {projects.map((project, i) => {
        const slug = project.file.split('/').pop()?.replace('.mdx', '');
        return (
          <ProjectCard
            title={project.frontmatter.title}
            description={project.frontmatter.description}
            cover={project.frontmatter.cover}
            href={`/projects/${slug}`}
            tags={project.frontmatter.tags}
            index={i}
          />
        );
      })}
    </div>
  </section>
</BaseLayout>
