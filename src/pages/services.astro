---
import BaseLayout from '@layouts/BaseLayout.astro';

const services = [
  {
    title: '3D Modeling',
    description: 'High-quality polygonal and subdivision surface modeling for games, film, and product visualization. From hard-surface props to organic shapes.',
    icon: '&#9632;',
    color: 'accent',
  },
  {
    title: 'Texturing & Materials',
    description: 'PBR and hand-painted texturing using Substance Painter and Designer. Custom material creation, UV mapping, and baking workflows.',
    icon: '&#9673;',
    color: 'accent-cyan',
  },
  {
    title: 'Environment Design',
    description: 'Complete environment creation from concept to final render. Interior and exterior scenes with attention to composition, lighting, and storytelling.',
    icon: '&#9826;',
    color: 'accent-emerald',
  },
  {
    title: 'Character & Sculpting',
    description: 'Digital sculpting for characters, creatures, and collectibles. High-poly sculpts with retopology and game-ready optimization.',
    icon: '&#9733;',
    color: 'accent-rose',
  },
  {
    title: 'Lighting & Rendering',
    description: 'Studio and environmental lighting setups for portfolio-quality renders. Experienced with real-time (UE5, Unity) and offline renderers.',
    icon: '&#9788;',
    color: 'accent-amber',
  },
  {
    title: 'Concept Visualization',
    description: 'Rapid 3D visualization of concepts and ideas. Ideal for pitches, pre-production, and design exploration before committing to full production.',
    icon: '&#9670;',
    color: 'accent-light',
  },
];

const process = [
  {
    step: '01',
    title: 'Brief & Discovery',
    description: 'We discuss your project goals, references, timeline, and deliverables to align on a clear vision.',
  },
  {
    step: '02',
    title: 'Concept & Blockout',
    description: 'I create initial blockouts or sketches for your approval before investing in detail work.',
  },
  {
    step: '03',
    title: 'Production',
    description: 'Full modeling, texturing, and scene assembly with regular check-ins and progress updates.',
  },
  {
    step: '04',
    title: 'Review & Delivery',
    description: 'Final renders, revisions, and delivery of all assets in your required formats.',
  },
];
---

<BaseLayout
  title="Services - Georgios Giannakoudakis"
  description="3D art services by Georgios Giannakoudakis. Modeling, texturing, environment design, character sculpting, and more."
>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-24 pb-16 md:pt-32">
    <p class="text-sm font-mono text-accent-light mb-4">Services</p>
    <h1 class="font-display text-4xl md:text-5xl font-bold text-white mb-6 max-w-2xl">
      Bringing ideas to life in <span class="gradient-text">three dimensions</span>
    </h1>
    <p class="text-lg text-gray-500 max-w-xl">
      Available for freelance projects, contract work, and collaborations. Whether you need a single asset or a full environment, I can help.
    </p>
  </section>

  <!-- Services Grid -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((service) => (
        <div class="group p-6 rounded-xl bg-surface-100 border border-white/5 hover:border-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class={`text-2xl mb-4 text-${service.color}`} set:html={service.icon} />
          <h3 class="font-display text-lg font-semibold text-white mb-2 group-hover:text-accent-light transition-colors">
            {service.title}
          </h3>
          <p class="text-sm text-gray-500 leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <h2 class="font-display text-2xl font-semibold text-white mb-10">How I Work</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {process.map((item) => (
        <div class="relative p-6 rounded-xl bg-surface-50 border border-white/5">
          <span class="text-4xl font-display font-bold text-surface-400">{item.step}</span>
          <h3 class="font-display text-base font-semibold text-white mt-3 mb-2">
            {item.title}
          </h3>
          <p class="text-sm text-gray-500 leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="rounded-2xl bg-surface-100 border border-white/5 p-10 md:p-16 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Have a project in mind?
      </h2>
      <p class="text-gray-500 mb-8 max-w-lg mx-auto">
        I'd love to hear about it. Head over to my contact form and tell me what you have in mind.
      </p>
      <a
        href="/about#contact"
        class="inline-flex items-center gap-2 px-8 py-3 rounded-lg bg-accent hover:bg-accent-dark text-white font-medium transition-colors"
      >
        Get in Touch
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
