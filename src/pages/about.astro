---
import BaseLayout from '@layouts/BaseLayout.astro';
import { url } from '../lib/base';
---

<BaseLayout
  title="About - Georgios Giannakoudakis"
  description="About Georgios Giannakoudakis - 3D Artist with an MSc from Utrecht University."
>
  <!-- Profile Hero -->
  <section class="max-w-4xl mx-auto px-6 pt-24 pb-8 md:pt-32">
    <div class="flex flex-col md:flex-row items-start gap-10 mb-12">
      <div class="shrink-0">
        <img
          src={url('/georgios-profile.jpg')}
          alt="Georgios Giannakoudakis"
          class="w-40 h-40 md:w-48 md:h-48 rounded-2xl object-cover border-2 border-white/10 shadow-lg shadow-accent/10"
        />
      </div>
      <div>
        <p class="text-sm font-mono text-accent-light mb-3">About</p>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white mb-3">
          Georgios Giannakoudakis
        </h1>
        <p class="text-lg text-gray-400">
          3D Artist / Designer
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-16">
    <div class="grid md:grid-cols-3 gap-12">
      <!-- Bio -->
      <div class="md:col-span-2 space-y-6 text-gray-400 leading-relaxed">
        <p>
          <strong class="text-gray-200">Nine years</strong> of dedicated work in <strong class="text-gray-200">3D visualization</strong>
          have shaped my expertise across <strong class="text-gray-200">modeling</strong>, <strong class="text-gray-200">materials</strong>,
          <strong class="text-gray-200">lighting</strong>, and <strong class="text-gray-200">rendering</strong>.
          I've been working with <strong class="text-gray-200">Blender</strong> since its earlier versions
          and have been pushing the craft ever since, driven by curiosity and a hands-on approach to learning.
        </p>
        <p>
          My work spans a wide range of domains. As a <strong class="text-gray-200">Research Associate</strong> at the
          <strong class="text-gray-200">Hellenic Mediterranean University</strong> in Greece (2021-2023), I developed
          visualization tools for robotics simulation platforms. At
          <a href="https://www.imai-medtech.com" target="_blank" rel="noopener noreferrer" class="text-accent-light hover:text-accent transition-colors"><strong>IMAI-MedTech</strong></a>,
          a medtech startup in Zurich (2023-2024), I led the development of a
          <strong class="text-gray-200">custom visualization pipeline within Blender</strong>
          to convert medical imaging data into 3D, producing animations that directly contributed to
          securing research funding. I have also created <strong class="text-gray-200">promotional posters and visual identities</strong>
          for media productions, and designed <strong class="text-gray-200">3D environments and product visualizations</strong>
          for various clients. Currently, at
          <a href="https://robo.com.cy" target="_blank" rel="noopener noreferrer" class="text-accent-light hover:text-accent transition-colors"><strong>ROBO Educational &amp; Research Robotics</strong></a>
          (2025), I design <strong class="text-gray-200">photo-realistic promotional videos</strong> for their upcoming
          <a href="https://roboblockslanding.apps.robo.com.cy" target="_blank" rel="noopener noreferrer" class="text-accent-light hover:text-accent transition-colors">ROBO Blocks</a>
          project, building complete scenes with <strong class="text-gray-200">high-quality texturing</strong> down to the smallest component.
        </p>
        <p>
          I also work with <strong class="text-gray-200">Unreal Engine</strong> for
          <strong class="text-gray-200">interactive environments</strong> and <strong class="text-gray-200">real-time workflows</strong>,
          including VR/AR/XR applications. I'm comfortable across the full production pipeline and
          thrive at the intersection of artistic quality and technical precision.
        </p>
        <p>
          Outside of work, bikes, sports, and winter sea swimming in Greece keep me moving.
        </p>
        <p>
          Interested in working together? <a href="mailto:giannakzorz@gmail.com" class="text-accent-light hover:text-accent transition-colors">Send me an email</a>.
        </p>
      </div>

      <!-- Info sidebar -->
      <div class="space-y-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Education</p>
          <p class="text-sm text-gray-300">MSc in Nanomaterials</p>
          <p class="text-sm text-gray-400">Utrecht University, Netherlands</p>
          <div class="mt-2">
            <p class="text-sm text-gray-300">BSc in Physics</p>
            <p class="text-sm text-gray-400">University of Crete, Greece</p>
          </div>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Skills</p>
          <div class="flex flex-wrap gap-2">
            {[
              '3D Modeling', 'Texturing', 'Lighting', 'Shading',
              'Animation', 'Rendering', 'Retopology', 'Rigging',
              'UV Mapping', 'PBR Materials', 'Asset Optimization',
              'Environment Design', 'Product Visualization',
              'VR/AR/XR', 'Visual Storytelling',
            ].map((skill) => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-surface-200 text-gray-400 border border-white/5">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Software</p>
          <div class="flex flex-wrap gap-2">
            {[
              'Blender', 'Cinema 4D', 'Unreal Engine',
              'Substance Painter', 'Substance Designer',
              'Photoshop', 'Arduino',
            ].map((sw) => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-surface-200 text-gray-400 border border-white/5">
                {sw}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Connect</p>
          <div class="space-y-2">
            <a href="https://www.artstation.com/georgegiannakoudakis5" target="_blank" rel="noopener noreferrer" class="block text-sm text-gray-400 hover:text-accent-light transition-colors">
              ArtStation &rarr;
            </a>
            <a href="https://www.linkedin.com/in/giorgos-giannakoudakis-0b2095124/" target="_blank" rel="noopener noreferrer" class="block text-sm text-gray-400 hover:text-accent-light transition-colors">
              LinkedIn &rarr;
            </a>
            <a href="mailto:giannakzorz@gmail.com" class="block text-sm text-gray-400 hover:text-accent-light transition-colors">
              Email &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
