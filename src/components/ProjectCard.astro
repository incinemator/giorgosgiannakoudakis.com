---
interface Props {
  title: string;
  description: string;
  cover: string;
  href: string;
  tags?: string[];
  index: number;
}

const { title, description, cover, href, tags = [], index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a
  href={href}
  class="group relative block overflow-hidden rounded-xl bg-surface-100 border border-white/5 card-hover"
  style={`animation-delay: ${index * 80}ms`}
>
  <!-- Image -->
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <!-- Overlay on hover -->
    <div class="absolute inset-0 bg-gradient-to-t from-surface-50 via-surface-50/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
  </div>

  <!-- Content overlay (always visible at bottom) -->
  <div class="absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-surface-50 via-surface-50/95 to-transparent">
    <div class="flex items-start justify-between mb-2">
      <span class="text-xs font-mono text-gray-600">{num}</span>
      <svg
        class="w-4 h-4 text-gray-600 group-hover:text-accent-light group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
      </svg>
    </div>
    <h3 class="font-display font-semibold text-white text-lg leading-snug mb-1.5 group-hover:text-accent-light transition-colors">
      {title}
    </h3>
    <p class="text-sm text-gray-500 line-clamp-2 mb-3">{description}</p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <span class="px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-full bg-white/5 text-gray-500">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
