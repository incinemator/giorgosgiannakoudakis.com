---
import { url } from '../lib/base';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Projects' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: 'https://www.artstation.com/georgegiannakoudakis5', label: 'ArtStation', external: true },
];
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={url('/')} class="font-display font-semibold text-lg text-white tracking-tight hover:text-accent-light transition-colors">
      Georgios Giannakoudakis
    </a>

    <div class="flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.external ? link.href : url(link.href)}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class:list={[
            'text-sm font-medium transition-colors relative',
            !link.external && currentPath.endsWith(link.href === '/' ? '/' : link.href + '/')
              ? 'text-white'
              : 'text-gray-500 hover:text-gray-300',
          ]}
        >
          {link.label}
          {!link.external && currentPath.endsWith(link.href === '/' ? '/' : link.href + '/') && (
            <span class="absolute -bottom-1 left-0 right-0 h-px bg-accent" />
          )}
        </a>
      ))}
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-gray-400 hover:text-white transition-colors"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 px-6 pb-4">
    {navLinks.map((link) => (
      <a
        href={link.external ? link.href : url(link.href)}
        {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        class:list={[
          'block py-2 text-sm font-medium transition-colors',
          !link.external && currentPath.endsWith(link.href === '/' ? '/' : link.href + '/')
            ? 'text-white'
            : 'text-gray-500 hover:text-gray-300',
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
