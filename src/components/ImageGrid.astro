---
interface Props {
  columns?: 1 | 2 | 3;
  gap?: 'sm' | 'md' | 'lg';
}

const { columns = 2, gap = 'md' } = Astro.props;

const colClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
};

const gapClasses = {
  sm: 'gap-2',
  md: 'gap-4',
  lg: 'gap-6',
};
---

<div class={`grid ${colClasses[columns]} ${gapClasses[gap]} my-8`}>
  <slot />
</div>
