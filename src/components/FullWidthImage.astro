---
import { url } from '../lib/base';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-12 -mx-6 md:-mx-12">
  <img
    src={url(src)}
    alt={alt}
    class="w-full rounded-lg"
    loading="lazy"
  />
  {caption && (
    <figcaption class="text-center text-sm text-gray-600 mt-3 px-6">
      {caption}
    </figcaption>
  )}
</figure>
