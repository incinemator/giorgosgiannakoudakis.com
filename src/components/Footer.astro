---
import { url } from '../lib/base';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 mt-32">
  <div class="max-w-7xl mx-auto px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-sm text-gray-600">
      &copy; {year} Georgios Giannakoudakis. All rights reserved.
    </p>
    <div class="flex items-center gap-6">
      <a
        href="https://www.artstation.com/georgegiannakoudakis5"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-600 hover:text-gray-400 transition-colors"
      >
        ArtStation
      </a>
      <a
        href="https://www.linkedin.com/in/giorgos-giannakoudakis-0b2095124/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-600 hover:text-gray-400 transition-colors"
      >
        LinkedIn
      </a>
      <a
        href={url('/about#contact')}
        class="text-sm text-gray-600 hover:text-gray-400 transition-colors"
      >
        Contact
      </a>
    </div>
  </div>
</footer>
