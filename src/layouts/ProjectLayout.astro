---
import BaseLayout from './BaseLayout.astro';
import Lightbox from '@components/Lightbox.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    cover: string;
    tags?: string[];
    software?: string[];
    role?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, cover, tags = [], software = [], role, date } = frontmatter;
---

<BaseLayout title={`${title} - Georgios Giannakoudakis`} description={description} image={cover}>
  <!-- Hero -->
  <div class="relative w-full h-[60vh] min-h-[400px] overflow-hidden">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/60 to-transparent" />
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12 max-w-5xl mx-auto">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/10 text-gray-300 backdrop-blur-sm">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-3 leading-tight">
        {title}
      </h1>
      <p class="text-lg text-gray-400 max-w-2xl">{description}</p>
    </div>
  </div>

  <!-- Meta bar -->
  <div class="max-w-5xl mx-auto px-6 md:px-12 py-8 flex flex-wrap gap-8 border-b border-white/5">
    {role && (
      <div>
        <p class="text-xs uppercase tracking-wider text-gray-600 mb-1">Role</p>
        <p class="text-sm text-gray-300">{role}</p>
      </div>
    )}
    <div>
      <p class="text-xs uppercase tracking-wider text-gray-600 mb-1">Date</p>
      <p class="text-sm text-gray-300">{date}</p>
    </div>
    {software.length > 0 && (
      <div>
        <p class="text-xs uppercase tracking-wider text-gray-600 mb-1">Software</p>
        <p class="text-sm text-gray-300">{software.join(', ')}</p>
      </div>
    )}
  </div>

  <!-- Content -->
  <article class="max-w-5xl mx-auto px-6 md:px-12 py-12 prose-project">
    <slot />
  </article>

  <!-- Back link -->
  <div class="max-w-5xl mx-auto px-6 md:px-12 pb-16">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-white transition-colors group"
    >
      <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 12H5m0 0l7 7m-7-7l7-7" />
      </svg>
      Back to all projects
    </a>
  </div>

  <Lightbox />
</BaseLayout>
